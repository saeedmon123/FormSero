# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real secrets.

# Stripe secret key (Developers -> API keys -> Secret key). Starts with sk_live_ or sk_test_.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for the /api/webhooks/stripe endpoint
# (Developers -> Webhooks -> your endpoint -> Signing secret). Starts with whsec_.
STRIPE_WEBHOOK_SECRET=

# The two Payment Link IDs (NOT the checkout URLs) — find them by running
# `node scripts/find-payment-links.mjs` locally once STRIPE_SECRET_KEY is set.
# Each looks like plink_XXXXXXXXXXXXXXXXXXXXXXXX.
STRIPE_LIGHT_PAYMENT_LINK_ID=
STRIPE_FULL_PAYMENT_LINK_ID=

# Resend (resend.com) API key: Dashboard -> API Keys -> Create API Key.
RESEND_API_KEY=

# The "From" address for purchase emails. Using the sandbox address works
# immediately but can only deliver to your own Resend account email; verify
# a domain in Resend to send to real customers from e.g. hello@formsero.com.
RESEND_FROM_EMAIL=FORMSERO <onboarding@resend.dev>
